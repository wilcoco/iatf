generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. 기준정보 (Master Data)
// ============================================

model Department {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  parentId  Int?     @map("parent_id")
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  managerId Int?     @map("manager_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users               User[]
  targetControlItems  ControlItem[] @relation("TargetDepartment")
  responsibleControlItems ControlItem[] @relation("ResponsibleDepartment")
  processes           Process[]
  equipment           Equipment[]
  measuringInstruments MeasuringInstrument[]
  kpiDefinitions      KpiDefinition[]
  emergencyTypes      EmergencyType[]
  auditRecords        AuditRecord[]

  @@map("departments")
}

model User {
  id           Int      @id @default(autoincrement())
  employeeId   String   @unique @map("employee_id") @db.VarChar(20)
  name         String   @db.VarChar(50)
  email        String?  @unique @db.VarChar(100)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  departmentId Int?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  position     String?  @db.VarChar(50)
  role         String   @default("user") @db.VarChar(20) // admin, manager, user
  hireDate     DateTime? @map("hire_date") @db.Date
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  responsibleControlItems ControlItem[]
  inspectionRecords       InspectionRecord[] @relation("Inspector")
  verifiedInspections     InspectionRecord[] @relation("Verifier")
  equipmentDailyChecks    EquipmentDailyCheck[]
  maintenancePerformed    MaintenanceRecord[] @relation("PerformedBy")
  maintenanceVerified     MaintenanceRecord[] @relation("VerifiedBy")
  moldRecords             MoldRecord[]
  jigRecords              JigRecord[]
  productionInspections   ProductionInspection[]
  incomingInspections     IncomingInspection[]
  shippingInspections     ShippingInspection[]
  reliabilityTests        ReliabilityTest[]
  adhesionTests           AdhesionTest[]
  colorMeasurements       ColorMeasurement[]
  coatingThickness        CoatingThickness[]
  gageRnrStudies          GageRnrStudy[]
  processCapabilities     ProcessCapability[]
  trainingRecords         TrainingRecord[]
  qualificationAssessments QualificationAssessment[] @relation("Assessed")
  evaluator1Assessments   QualificationAssessment[] @relation("Evaluator1")
  evaluator2Assessments   QualificationAssessment[] @relation("Evaluator2")
  evaluator3Assessments   QualificationAssessment[] @relation("Evaluator3")
  reportedNonconformances Nonconformance[]
  correctiveActionLeader  CorrectiveAction[] @relation("TeamLeader")
  correctiveActionVerifier CorrectiveAction[] @relation("VerifiedBy")
  leadAudits              AuditPlan[]
  auditRecords            AuditRecord[] @relation("Auditor")
  auditeeRecords          AuditRecord[] @relation("Auditee")
  kpiResults              KpiResult[]
  emergencyDrills         EmergencyDrill[]
  supplierEvaluations     SupplierEvaluation[]
  uploadedAttachments     Attachment[]
  receivedReminders       Reminder[]
  auditLogs               AuditLog[]

  @@map("users")
}

model Process {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(200)
  category      String?  @db.VarChar(50) // 품질, 생산, 구매, 개발 등
  documentNo    String?  @map("document_no") @db.VarChar(50)
  revision      String?  @db.VarChar(10)
  effectiveDate DateTime? @map("effective_date") @db.Date
  ownerDeptId   Int?     @map("owner_dept_id")
  ownerDept     Department? @relation(fields: [ownerDeptId], references: [id])
  description   String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  controlItems  ControlItem[]
  kpiDefinitions KpiDefinition[]
  auditRecords  AuditRecord[]

  @@map("processes")
}

model ControlItem {
  id                  Int      @id @default(autoincrement())
  itemNo              Int      @unique @map("item_no")
  processId           Int?     @map("process_id")
  process             Process? @relation(fields: [processId], references: [id])
  name                String   @db.VarChar(500)
  description         String?  @db.Text
  frequency           String?  @db.VarChar(50) // 일, 주, 월, 분기, 반기, 년, 발생시, 년/필요시 등
  frequencyDays       Int?     @map("frequency_days")
  targetDeptId        Int?     @map("target_dept_id")
  targetDept          Department? @relation("TargetDepartment", fields: [targetDeptId], references: [id])
  responsibleDeptId   Int?     @map("responsible_dept_id")
  responsibleDept     Department? @relation("ResponsibleDepartment", fields: [responsibleDeptId], references: [id])
  responsibleUserId   Int?     @map("responsible_user_id")
  responsibleUser     User?    @relation(fields: [responsibleUserId], references: [id])
  formType            String?  @map("form_type") @db.VarChar(50)
  sampleForm          String?  @map("sample_form") @db.VarChar(500) // 샘플양식 파일명
  requiresAttachment  Boolean  @default(false) @map("requires_attachment")
  isActive            Boolean  @default(true) @map("is_active")
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  inspectionRecords   InspectionRecord[]

  @@map("control_items")
}

model VehicleModel {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  customer  String?  @db.VarChar(50) // 현대, 기아 등
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  parts     Part[]

  @@map("vehicle_models")
}

model Part {
  id             Int      @id @default(autoincrement())
  partNo         String   @unique @map("part_no") @db.VarChar(50)
  name           String   @db.VarChar(200)
  vehicleModelId Int?     @map("vehicle_model_id")
  vehicleModel   VehicleModel? @relation(fields: [vehicleModelId], references: [id])
  category       String?  @db.VarChar(50) // 사출, 도장, 조립 등
  material       String?  @db.VarChar(100)
  color          String?  @db.VarChar(50)
  supplierId     Int?     @map("supplier_id")
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  molds                Part_Molds[]
  jigs                 Jig[]
  productionInspections ProductionInspection[]
  incomingInspections  IncomingInspection[]
  shippingInspections  ShippingInspection[]
  reliabilityTests     ReliabilityTest[]
  adhesionTests        AdhesionTest[]
  colorMeasurements    ColorMeasurement[]
  coatingThickness     CoatingThickness[]
  gageRnrStudies       GageRnrStudy[]
  processCapabilities  ProcessCapability[]
  nonconformances      Nonconformance[]

  @@map("parts")
}

model Supplier {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(20)
  name         String   @db.VarChar(200)
  type         String?  @db.VarChar(20) // 1차, 2차, 외주
  businessNo   String?  @map("business_no") @db.VarChar(20)
  address      String?  @db.Text
  contactName  String?  @map("contact_name") @db.VarChar(50)
  contactPhone String?  @map("contact_phone") @db.VarChar(20)
  contactEmail String?  @map("contact_email") @db.VarChar(100)
  grade        String?  @db.VarChar(10) // A, B, C, D
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parts                Part[]
  incomingInspections  IncomingInspection[]
  evaluations          SupplierEvaluation[]
  deliveryPerformance  SupplierDeliveryPerformance[]
  qualityPerformance   SupplierQualityPerformance[]

  @@map("suppliers")
}

model Equipment {
  id           Int      @id @default(autoincrement())
  assetNo      String   @unique @map("asset_no") @db.VarChar(50)
  name         String   @db.VarChar(200)
  category     String?  @db.VarChar(50) // 사출기, 도장설비, 조립설비 등
  location     String?  @db.VarChar(100)
  manufacturer String?  @db.VarChar(100)
  model        String?  @db.VarChar(100)
  installDate  DateTime? @map("install_date") @db.Date
  departmentId Int?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  status       String   @default("active") @db.VarChar(20) // active, maintenance, inactive
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  dailyChecks      EquipmentDailyCheck[]
  maintenanceRecords MaintenanceRecord[]

  @@map("equipment")
}

model Mold {
  id                  Int      @id @default(autoincrement())
  moldNo              String   @unique @map("mold_no") @db.VarChar(50)
  name                String   @db.VarChar(200)
  cavityCount         Int?     @map("cavity_count")
  storageLocation     String?  @map("storage_location") @db.VarChar(100)
  owner               String?  @db.VarChar(50) // 자사, 고객사
  status              String   @default("active") @db.VarChar(20)
  lastMaintenanceDate DateTime? @map("last_maintenance_date") @db.Date
  shotCount           Int      @default(0) @map("shot_count")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  parts       Part_Molds[]
  moldRecords MoldRecord[]

  @@map("molds")
}

model Part_Molds {
  partId  Int  @map("part_id")
  part    Part @relation(fields: [partId], references: [id])
  moldId  Int  @map("mold_id")
  mold    Mold @relation(fields: [moldId], references: [id])

  @@id([partId, moldId])
  @@map("part_molds")
}

model Jig {
  id        Int      @id @default(autoincrement())
  jigNo     String   @unique @map("jig_no") @db.VarChar(50)
  name      String   @db.VarChar(200)
  type      String?  @db.VarChar(50) // 도장지그, 조립지그, 검사지그
  process   String?  @db.VarChar(50)
  partId    Int?     @map("part_id")
  part      Part?    @relation(fields: [partId], references: [id])
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jigRecords JigRecord[]

  @@map("jigs")
}

model MeasuringInstrument {
  id                  Int      @id @default(autoincrement())
  instrumentNo        String   @unique @map("instrument_no") @db.VarChar(50)
  name                String   @db.VarChar(100)
  type                String?  @db.VarChar(50) // 버니어, 갭자, 다이얼, 푸쉬풀 등
  range               String?  @db.VarChar(50)
  resolution          String?  @db.VarChar(20)
  departmentId        Int?     @map("department_id")
  department          Department? @relation(fields: [departmentId], references: [id])
  location            String?  @db.VarChar(100)
  calibrationCycle    Int?     @map("calibration_cycle") // 교정주기(월)
  lastCalibrationDate DateTime? @map("last_calibration_date") @db.Date
  nextCalibrationDate DateTime? @map("next_calibration_date") @db.Date
  status              String   @default("active") @db.VarChar(20)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  calibrationRecords CalibrationRecord[]
  gageRnrStudies     GageRnrStudy[]

  @@map("measuring_instruments")
}

// ============================================
// 2. 일상 점검/기록 데이터
// ============================================

model InspectionRecord {
  id              Int      @id @default(autoincrement())
  controlItemId   Int?     @map("control_item_id")
  controlItem     ControlItem? @relation(fields: [controlItemId], references: [id])
  inspectionType  String?  @map("inspection_type") @db.VarChar(50) // 일상, 정기, 특별
  inspectionDate  DateTime @map("inspection_date") @db.Date
  shift           String?  @db.VarChar(10) // A조, B조, C조
  targetType      String?  @map("target_type") @db.VarChar(50) // equipment, mold, jig, part 등
  targetId        Int?     @map("target_id")
  inspectorId     Int?     @map("inspector_id")
  inspector       User?    @relation("Inspector", fields: [inspectorId], references: [id])
  result          String?  @db.VarChar(20) // 합격, 불합격, 조건부
  score           Decimal? @db.Decimal(5, 2)
  findings        String?  @db.Text
  attachments     Json?
  verifiedBy      Int?     @map("verified_by")
  verifier        User?    @relation("Verifier", fields: [verifiedBy], references: [id])
  verifiedAt      DateTime? @map("verified_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  details InspectionDetail[]

  @@map("inspection_records")
}

model InspectionDetail {
  id            Int      @id @default(autoincrement())
  inspectionId  Int      @map("inspection_id")
  inspection    InspectionRecord @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checkItem     String   @map("check_item") @db.VarChar(200)
  standard      String?  @db.VarChar(200)
  method        String?  @db.VarChar(100)
  measuredValue String?  @map("measured_value") @db.VarChar(100)
  result        String?  @db.VarChar(20) // OK, NG, NA
  remarks       String?  @db.Text
  seqNo         Int?     @map("seq_no")

  @@map("inspection_details")
}

model EquipmentDailyCheck {
  id                Int      @id @default(autoincrement())
  equipmentId       Int      @map("equipment_id")
  equipment         Equipment @relation(fields: [equipmentId], references: [id])
  checkDate         DateTime @map("check_date") @db.Date
  shift             String?  @db.VarChar(10)
  checkerId         Int?     @map("checker_id")
  checker           User?    @relation(fields: [checkerId], references: [id])
  appearance        String?  @db.VarChar(10) // OK, NG
  abnormalSound     String?  @map("abnormal_sound") @db.VarChar(10)
  abnormalVibration String?  @map("abnormal_vibration") @db.VarChar(10)
  oilLevel          String?  @map("oil_level") @db.VarChar(10)
  airPressure       String?  @map("air_pressure") @db.VarChar(10)
  temperature       Decimal? @db.Decimal(5, 1)
  overallStatus     String?  @map("overall_status") @db.VarChar(20) // 정상, 이상, 수리필요
  remarks           String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([equipmentId, checkDate, shift])
  @@map("equipment_daily_checks")
}

model MaintenanceRecord {
  id                  Int      @id @default(autoincrement())
  equipmentId         Int?     @map("equipment_id")
  equipment           Equipment? @relation(fields: [equipmentId], references: [id])
  maintenanceType     String?  @map("maintenance_type") @db.VarChar(20) // 예방, 사후, 개량
  planDate            DateTime? @map("plan_date") @db.Date
  actualDate          DateTime? @map("actual_date") @db.Date
  workDescription     String?  @map("work_description") @db.Text
  partsReplaced       Json?    @map("parts_replaced")
  downtimeHours       Decimal? @map("downtime_hours") @db.Decimal(5, 1)
  cost                Decimal? @db.Decimal(12, 2)
  performedById       Int?     @map("performed_by")
  performedBy         User?    @relation("PerformedBy", fields: [performedById], references: [id])
  verifiedById        Int?     @map("verified_by")
  verifiedBy          User?    @relation("VerifiedBy", fields: [verifiedById], references: [id])
  nextMaintenanceDate DateTime? @map("next_maintenance_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("maintenance_records")
}

model MoldRecord {
  id               Int      @id @default(autoincrement())
  moldId           Int      @map("mold_id")
  mold             Mold     @relation(fields: [moldId], references: [id])
  recordType       String   @map("record_type") @db.VarChar(20) // 일상점검, 습합, 세척, 보수
  recordDate       DateTime @map("record_date") @db.Date
  partingLine      String?  @map("parting_line") @db.VarChar(10)
  ejectorPin       String?  @map("ejector_pin") @db.VarChar(10)
  coolingChannel   String?  @map("cooling_channel") @db.VarChar(10)
  guidePin         String?  @map("guide_pin") @db.VarChar(10)
  issueDescription String?  @map("issue_description") @db.Text
  repairAction     String?  @map("repair_action") @db.Text
  partsReplaced    String?  @map("parts_replaced") @db.Text
  shotCountAtCheck Int?     @map("shot_count_at_check")
  performerId      Int?     @map("performer_id")
  performer        User?    @relation(fields: [performerId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("mold_records")
}

model JigRecord {
  id             Int      @id @default(autoincrement())
  jigId          Int      @map("jig_id")
  jig            Jig      @relation(fields: [jigId], references: [id])
  recordType     String   @map("record_type") @db.VarChar(20) // 일상점검, 정도검증, 박리(도장)
  recordDate     DateTime @map("record_date") @db.Date
  status         String?  @db.VarChar(20) // 정상, 이상, 수리필요
  measuredValues Json?    @map("measured_values")
  remarks        String?  @db.Text
  performerId    Int?     @map("performer_id")
  performer      User?    @relation(fields: [performerId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("jig_records")
}

model CalibrationRecord {
  id                  Int      @id @default(autoincrement())
  instrumentId        Int      @map("instrument_id")
  instrument          MeasuringInstrument @relation(fields: [instrumentId], references: [id])
  calibrationDate     DateTime @map("calibration_date") @db.Date
  calibrationType     String?  @map("calibration_type") @db.VarChar(20) // 사내, 외부
  calibrator          String?  @db.VarChar(100) // 교정기관/담당자
  standardUsed        String?  @map("standard_used") @db.VarChar(200)
  result              String?  @db.VarChar(20) // 합격, 불합격, 조건부
  beforeValues        Json?    @map("before_values")
  afterValues         Json?    @map("after_values")
  uncertainty         Decimal? @db.Decimal(10, 6)
  certificateNo       String?  @map("certificate_no") @db.VarChar(50)
  certificateFile     String?  @map("certificate_file") @db.VarChar(255)
  nextCalibrationDate DateTime? @map("next_calibration_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("calibration_records")
}

// ============================================
// 3. 검사 데이터
// ============================================

model ProductionInspection {
  id              Int      @id @default(autoincrement())
  partId          Int      @map("part_id")
  part            Part     @relation(fields: [partId], references: [id])
  productionDate  DateTime @map("production_date") @db.Date
  shift           String?  @db.VarChar(10)
  lotNo           String?  @map("lot_no") @db.VarChar(50)
  inspectionType  String?  @map("inspection_type") @db.VarChar(10) // 초물, 중물, 종물
  inspectionTime  DateTime? @map("inspection_time") @db.Time()
  inspectorId     Int?     @map("inspector_id")
  inspector       User?    @relation(fields: [inspectorId], references: [id])
  visualCheck     String?  @map("visual_check") @db.VarChar(10)
  dimensionCheck  String?  @map("dimension_check") @db.VarChar(10)
  functionCheck   String?  @map("function_check") @db.VarChar(10)
  measuredValues  Json?    @map("measured_values")
  result          String?  @db.VarChar(20) // 합격, 불합격
  remarks         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("production_inspections")
}

model IncomingInspection {
  id              Int      @id @default(autoincrement())
  supplierId      Int?     @map("supplier_id")
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  partId          Int?     @map("part_id")
  part            Part?    @relation(fields: [partId], references: [id])
  receivingDate   DateTime @map("receiving_date") @db.Date
  lotNo           String?  @map("lot_no") @db.VarChar(50)
  quantity        Int?
  inspectionType  String?  @map("inspection_type") @db.VarChar(20) // 전수, 샘플링, 무검사
  sampleSize      Int?     @map("sample_size")
  inspectorId     Int?     @map("inspector_id")
  inspector       User?    @relation(fields: [inspectorId], references: [id])
  visualResult    String?  @map("visual_result") @db.VarChar(10)
  dimensionResult String?  @map("dimension_result") @db.VarChar(10)
  materialResult  String?  @map("material_result") @db.VarChar(10) // Mill Sheet 확인
  defectQty       Int      @default(0) @map("defect_qty")
  defectRate      Decimal? @map("defect_rate") @db.Decimal(5, 2)
  overallResult   String?  @map("overall_result") @db.VarChar(20)
  disposition     String?  @db.VarChar(20) // 합격입고, 반품, 특채
  supplierCertNo  String?  @map("supplier_cert_no") @db.VarChar(50)
  remarks         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("incoming_inspections")
}

model ShippingInspection {
  id              Int      @id @default(autoincrement())
  partId          Int      @map("part_id")
  part            Part     @relation(fields: [partId], references: [id])
  shippingDate    DateTime @map("shipping_date") @db.Date
  lotNo           String?  @map("lot_no") @db.VarChar(50)
  quantity        Int?
  destination     String?  @db.VarChar(100)
  inspectorId     Int?     @map("inspector_id")
  inspector       User?    @relation(fields: [inspectorId], references: [id])
  visualCheck     String?  @map("visual_check") @db.VarChar(10)
  dimensionCheck  String?  @map("dimension_check") @db.VarChar(10)
  packagingCheck  String?  @map("packaging_check") @db.VarChar(10)
  labelCheck      String?  @map("label_check") @db.VarChar(10)
  result          String?  @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("shipping_inspections")
}

// ============================================
// 4. 품질 시험/평가 데이터
// ============================================

model ReliabilityTest {
  id             Int      @id @default(autoincrement())
  partId         Int      @map("part_id")
  part           Part     @relation(fields: [partId], references: [id])
