# Railway에서 자동 주입되는 변수
# DATABASE_URL - PostgreSQL 연결 문자열 (Railway가 자동 제공)

# NextAuth 설정
NEXTAUTH_URL="${RAILWAY_PUBLIC_DOMAIN}"
NEXTAUTH_SECRET="${NEXTAUTH_SECRET}"

# API Keys (Railway Variables에서 설정)
API_KEY_ERP="${API_KEY_ERP}"
API_KEY_MES="${API_KEY_MES}"
API_KEY_MOBILE="${API_KEY_MOBILE}"
API_KEY_SUPPLIER="${API_KEY_SUPPLIER}"

# 환경
NODE_ENV=production
